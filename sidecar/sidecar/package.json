{
  "name": "sharp-worker",
  "version": "1.1.0",
  "description": "LightAlbum Sharp Sidecar — HEIC/RAW thumbnail generator for Tauri",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "test":  "node test/smoke.js",
    "build": "node scripts/bundle.js",
    "build:all": "node scripts/bundle.js --all",
    "build:win": "node scripts/bundle.js --target x86_64-pc-windows-msvc",
    "build:mac-x64": "node scripts/bundle.js --target x86_64-apple-darwin",
    "build:mac-arm": "node scripts/bundle.js --target aarch64-apple-darwin",
    "build:linux": "node scripts/bundle.js --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node20-win-x64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-linux-x64"
    ],
    "assets": [
      "node_modules/sharp/**/*"
    ],
    "scripts": [],
    "outputPath": "../../src-tauri/binaries"
  }
}
