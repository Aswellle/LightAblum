{
  "name": "sharp-worker",
  "version": "2.0.0",
  "description": "LightAlbum Sharp Sidecar — HEIC/RAW thumbnail & decode worker",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "test": "node test/smoke.js",
    "test:v": "node test/smoke.js --verbose",
    "build": "node scripts/bundle.js",
    "build:all": "node scripts/bundle.js --all",
    "lint": "node -e \"require('.'); console.log('Syntax OK');\""
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.11.0"
  },
  "pkg": {
    "targets": [
      "node20-win-x64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-linux-x64"
    ],
    "assets": [
      "node_modules/sharp/build/**/*",
      "node_modules/sharp/lib/**/*",
      "node_modules/sharp/vendor/**/*"
    ],
    "outputPath": "../../src-tauri/binaries"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
